{"clip": "R-BDR-001__default", "id": "R-BDR-001", "group": "rule_title", "voice": "default", "text": "সীমার ওপরে: নিয়ন্ত্রণের উপায় নিয়ে এখনই আপনার কর্মকর্তার সঙ্গে যোগাযোগ করুন।", "terms": [], "audio_s": 6.72, "synth_s": 0.581, "rtf": 0.086, "opus_bytes": 22374, "tokens": 153}
