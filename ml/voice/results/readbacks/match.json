 "app_reads": [
  {
   "where": "plans.json BD-SAMPLE-02",
   "rule_id": "R-BDR-002",
   "version": 1,
   "text": "এখন স্প্রে দরকার নেই: পোকার সংখ্যা সীমার নিচে। কয়েক দিন পর আবার গুনে দেখুন।",
   "result": "match"
  },
  {
   "where": "plans.json BD-SAMPLE-02",
   "rule_id": "R-BDR-009",
   "version": 1,
   "text": "ঝড়বৃষ্টির পর ইউরিয়া সার দেবেন না; পাতাপোড়া রোগ দেখলে ইউরিয়া উপরি প্রয়োগ বন্ধ করুন।",
   "result": "match"
  },
  {
   "where": "plans.json BD-SAMPLE-02",
   "rule_id": "R-BDR-010",
   "version": 1,
   "text": "পাতার ডগা ও কিনারায় নীলচে, ভেজা ভেজা দাগ আছে কি না দেখুন। পেলে আপনার কর্মকর্তাকে জানান।",
   "result": "match"
  },
  {
   "where": "plans.json BD-SAMPLE-02",
   "rule_id": "R-BDR-001",
   "version": 1,
   "text": "সীমার ওপরে: নিয়ন্ত্রণের উপায় নিয়ে এখনই আপনার কর্মকর্তার সঙ্গে যোগাযোগ করুন।",
   "result": "match"
  },
  {
   "where": "plans.json BD-SAMPLE-01",
   "rule_id": "R-BDR-005",
   "version": 1,
   "text": "গাছে মাকড়সা খুঁজে দেখুন: বেশির ভাগ গাছে অন্তত একটি থাকলে মাকড়সা গাছফড়িং খাচ্ছে, তাই স্প্রে করার আগে আপনার কর্মকর্তাকে জিজ্ঞেস করুন।",
   "result": "match"
  },
  {
   "where": "plans.json BD-SAMPLE-01",
   "rule_id": "R-BDR-006",
   "version": 1,
   "text": "জমিতে পানি জমে থাকতে দেবেন না: পানি জমে থাকলে গাছফড়িংয়ের আক্রমণ বেশি হয়।",
   "result": "no clip"
  },
  {
   "where": "asks.json",
   "rule_id": "R-BDR-002",
   "version": 1,
   "text": "এখন স্প্রে দরকার নেই: পোকার সংখ্যা সীমার নিচে। কয়েক দিন পর আবার গুনে দেখুন।",
   "result": "match"
  }
 ],
