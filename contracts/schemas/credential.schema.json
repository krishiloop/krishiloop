{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krishiloop.example/schemas/credential.schema.json",
  "title": "KrishiLoopCredential",
  "description": "W3C Verifiable Credential 2.0 envelope for RuleCredential and AdviceReceiptCredential, secured with a Data Integrity proof (cryptosuite eddsa-jcs-2022) and a BitstringStatusListEntry for recall.",
  "type": "object",
  "required": [
    "@context",
    "id",
    "type",
    "issuer",
    "validFrom",
    "credentialSubject",
    "credentialStatus",
    "proof"
  ],
  "properties": {
    "@context": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "const": "https://www.w3.org/ns/credentials/v2"
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^urn:uuid:"
    },
    "type": {
      "type": "array",
      "minItems": 2,
      "prefixItems": [
        {
          "const": "VerifiableCredential"
        }
      ],
      "items": {
        "enum": [
          "VerifiableCredential",
          "RuleCredential",
          "AdviceReceiptCredential"
        ]
      }
    },
    "issuer": {
      "type": "string",
      "pattern": "^(did:web:|https://)"
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "credentialSubject": {
      "type": "object"
    },
    "credentialStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "statusPurpose",
        "statusListIndex",
        "statusListCredential"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "BitstringStatusListEntry"
        },
        "statusPurpose": {
          "enum": [
            "revocation",
            "suspension"
          ]
        },
        "statusListIndex": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "statusListCredential": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "proof": {
      "type": "object",
      "required": [
        "type",
        "cryptosuite",
        "created",
        "verificationMethod",
        "proofPurpose",
        "proofValue"
      ],
      "properties": {
        "type": {
          "const": "DataIntegrityProof"
        },
        "cryptosuite": {
          "const": "eddsa-jcs-2022"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "verificationMethod": {
          "type": "string"
        },
        "proofPurpose": {
          "const": "assertionMethod"
        },
        "proofValue": {
          "type": "string",
          "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "contains": {
              "const": "AdviceReceiptCredential"
            }
          }
        }
      },
      "then": {
        "properties": {
          "credentialSubject": {
            "$ref": "receipt.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "contains": {
              "const": "RuleCredential"
            }
          }
        }
      },
      "then": {
        "properties": {
          "credentialSubject": {
            "$ref": "#/$defs/rule_subject"
          }
        }
      }
    }
  ],
  "$defs": {
    "rule_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "version",
        "pack_id",
        "doc_id",
        "page",
        "quote_sha256",
        "review_level",
        "rule_sha256"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^R-[A-Z]{2,8}-[0-9]{3}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "pack_id": {
          "type": "string"
        },
        "doc_id": {
          "type": "string",
          "pattern": "^DOC-[A-Z0-9]{2,12}-[0-9]{3}$"
        },
        "page": {
          "type": [
            "integer",
            "string"
          ]
        },
        "quote_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rule_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "hash of the canonical rule YAML"
        },
        "review_level": {
          "enum": [
            "expert",
            "team",
            "pending"
          ]
        },
        "reviewed_by": {
          "type": "string"
        }
      }
    }
  }
}
