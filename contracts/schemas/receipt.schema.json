{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krishiloop.example/schemas/receipt.schema.json",
  "title": "Receipt",
  "description": "Evidence behind ONE recommendation, and the recommendation itself (Constitution Art. 1): the exact advice shown (text, decision, traffic light), its plan window, sources with verbatim quotes, data readings with timestamps, rule versions (each backed by a signed RuleCredential that can be recalled), confidence. Delivered inside an AdviceReceiptCredential (credential.schema.json), so editing the advice breaks the signature.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "claim",
    "plan",
    "advice",
    "sources",
    "data",
    "rule_refs",
    "confidence",
    "generated_by",
    "created_at"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "format": "uuid"
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "description": "action_id or statement this receipt supports"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reading"
      }
    },
    "rule_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule_ref"
      }
    },
    "reviewer_parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      },
      "description": "Numbers the rule uses that are NOT in the source (set by a reviewer); shown as such to users."
    },
    "graph_path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "basis"
      ],
      "properties": {
        "level": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planner_version",
        "validator_version"
      ],
      "properties": {
        "planner_version": {
          "type": "string"
        },
        "validator_version": {
          "type": "string"
        },
        "phrasing_model": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "advice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "kind",
        "title"
      ],
      "description": "The exact advice the farmer sees; signed.",
      "properties": {
        "action_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "action.schema.json#/properties/kind"
        },
        "title": {
          "$ref": "action.schema.json#/$defs/i18n"
        },
        "decision": {
          "enum": [
            "spray",
            "dont_spray",
            "recheck"
          ]
        },
        "traffic_light": {
          "enum": [
            "green",
            "amber",
            "red"
          ]
        },
        "phrasing_model": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "pack_id",
        "crop",
        "stage",
        "valid_from",
        "valid_to",
        "field_ref",
        "data_mode",
        "data_as_of"
      ],
      "properties": {
        "plan_id": {
          "type": "string",
          "format": "uuid"
        },
        "pack_id": {
          "type": "string"
        },
        "crop": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "valid_from": {
          "type": "string",
          "format": "date"
        },
        "valid_to": {
          "type": "string",
          "format": "date"
        },
        "field_ref": {
          "type": "string",
          "description": "hash of the field id; no location or PII"
        },
        "data_mode": {
          "enum": [
            "live",
            "snapshot",
            "sample"
          ]
        },
        "data_as_of": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_id",
        "title",
        "publisher",
        "page",
        "quote",
        "quote_sha256",
        "licence_status",
        "language"
      ],
      "properties": {
        "doc_id": {
          "type": "string",
          "pattern": "^DOC-[A-Z0-9]{2,12}-[0-9]{3}$"
        },
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "page": {
          "type": [
            "integer",
            "string"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "quote_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "licence_status": {
          "enum": [
            "cleared",
            "permitted",
            "cited_permission_requested"
          ]
        },
        "acknowledgement": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
          "description": "BCP-47 tag, e.g. bn, en, sw, hi."
        }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "variable",
        "value",
        "observed_at",
        "retrieved_at"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "variable": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        "unit": {
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "location_precision": {
          "enum": [
            "field_private",
            "fuzzed_1km",
            "union_level",
            "sample_location"
          ]
        },
        "forecast_for": {
          "type": "string",
          "format": "date",
          "description": "for forecasts: the day the value is forecast for (observed_at = forecast issue time)"
        }
      }
    },
    "rule_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "version",
        "credential_id",
        "review_level"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^R-[A-Z]{2,8}-[0-9]{3}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "credential_id": {
          "type": "string",
          "pattern": "^urn:uuid:"
        },
        "review_level": {
          "enum": [
            "expert",
            "team",
            "pending"
          ]
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "set_by",
        "note"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "unit": {
          "type": "string"
        },
        "set_by": {
          "enum": [
            "expert",
            "team"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
