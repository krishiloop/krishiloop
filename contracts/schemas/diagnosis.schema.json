{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krishiloop.example/schemas/diagnosis.schema.json",
  "title": "Diagnosis",
  "description": "On-device classifier result; the photo is NOT part of this object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnosis_id",
    "crop",
    "model",
    "on_device",
    "labels",
    "calibrated",
    "ood_score",
    "status",
    "inference_ms",
    "created_at"
  ],
  "properties": {
    "diagnosis_id": {
      "type": "string"
    },
    "crop": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "on_device": {
      "type": "boolean"
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/label_prob"
      }
    },
    "calibrated": {
      "type": "boolean"
    },
    "temperature": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "ood_score": {
      "type": "number"
    },
    "status": {
      "enum": [
        "ok",
        "abstained"
      ]
    },
    "abstention_reason": {
      "enum": [
        "low_confidence",
        "out_of_distribution",
        "missing_source",
        "validator_blocked",
        "conflicting_rules",
        "data_unavailable",
        "farmer_requested",
        "no_matching_rule"
      ]
    },
    "cam_available": {
      "type": "boolean"
    },
    "inference_ms": {
      "type": "number",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "abstained"
          }
        }
      },
      "then": {
        "required": [
          "abstention_reason"
        ]
      }
    }
  ],
  "$defs": {
    "label_prob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "prob"
      ],
      "properties": {
        "label": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "prob": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
