{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krishiloop.example/schemas/plan.schema.json",
  "title": "WeeklyPlan",
  "description": "Stage-aware, personalised plan for one field. status=ok -> 1..3 receipted actions with exactly one input decision; status=abstained -> reason + officer-inbox item.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "pack_id",
    "field_id",
    "farmer_profile_id",
    "status",
    "crop",
    "stage",
    "valid_from",
    "valid_to",
    "generated_at",
    "snapshot_id"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^pack-[a-z0-9-]+$",
      "examples": [
        "pack-bd-rice",
        "pack-potato-late-blight"
      ]
    },
    "field_id": {
      "type": "string"
    },
    "farmer_profile_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "abstained"
      ]
    },
    "crop": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "season": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_to": {
      "type": "string",
      "format": "date"
    },
    "actions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "action.schema.json"
      }
    },
    "personalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factors"
      ],
      "properties": {
        "factors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value",
              "effect"
            ],
            "properties": {
              "name": {
                "enum": [
                  "variety",
                  "stage",
                  "irrigation_source",
                  "budget",
                  "labour",
                  "voice_preference",
                  "past_outcome",
                  "soil_drainage",
                  "crop_protected"
                ]
              },
              "value": {
                "type": "string"
              },
              "effect": {
                "$ref": "action.schema.json#/$defs/i18n"
              }
            }
          }
        }
      }
    },
    "abstention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code",
        "reason",
        "inbox_item_id"
      ],
      "properties": {
        "reason_code": {
          "enum": [
            "low_confidence",
            "out_of_distribution",
            "missing_source",
            "validator_blocked",
            "conflicting_rules",
            "data_unavailable",
            "farmer_requested",
            "no_matching_rule",
            "rule_recalled",
            "data_stale"
          ]
        },
        "reason": {
          "$ref": "action.schema.json#/$defs/i18n"
        },
        "inbox_item_id": {
          "type": "string"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot_id": {
      "type": "string"
    },
    "data_mode": {
      "enum": [
        "live",
        "snapshot",
        "sample"
      ]
    },
    "data_as_of": {
      "type": "string",
      "format": "date-time"
    },
    "diagnosis_used": {
      "type": "boolean",
      "description": "true only if the photo passed the gate and could inform rules"
    },
    "diagnosis_note": {
      "enum": [
        "ok",
        "uncalibrated",
        "low_confidence",
        "out_of_distribution",
        "model_abstained"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "required": [
          "actions",
          "personalization"
        ],
        "properties": {
          "actions": {
            "minItems": 1,
            "contains": {
              "properties": {
                "kind": {
                  "const": "input_decision"
                }
              },
              "required": [
                "kind"
              ]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "abstained"
          }
        }
      },
      "then": {
        "required": [
          "abstention"
        ]
      }
    }
  ]
}
