{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krishiloop.example/schemas/share_link.schema.json",
  "title": "ShareLink",
  "description": "Farmer-initiated, scoped, expiring, revocable share of attestations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "share_id",
    "field_id",
    "scope",
    "expires_at",
    "created_at",
    "url"
  ],
  "properties": {
    "share_id": {
      "type": "string"
    },
    "field_id": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_ids",
        "include_photos"
      ],
      "properties": {
        "attestation_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "include_photos": {
          "type": "boolean"
        }
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "url": {
      "type": "string",
      "format": "uri"
    }
  }
}
