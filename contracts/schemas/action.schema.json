{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krishiloop.example/schemas/action.schema.json",
  "title": "Action",
  "description": "One recommended action; always carries a receipt. No generated doses or brand names (Art. 3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "kind",
    "title",
    "receipt"
  ],
  "properties": {
    "action_id": {
      "type": "string",
      "pattern": "^A-[a-z0-9-]{4,40}$"
    },
    "kind": {
      "enum": [
        "input_decision",
        "irrigation",
        "monitoring",
        "harvest",
        "nutrient",
        "officer_contact",
        "practice",
        "other"
      ]
    },
    "decision": {
      "enum": [
        "spray",
        "dont_spray",
        "recheck"
      ]
    },
    "traffic_light": {
      "enum": [
        "green",
        "amber",
        "red"
      ],
      "description": "UI: green = no action needed now, amber = re-check, red = act / contact officer"
    },
    "title": {
      "$ref": "#/$defs/i18n"
    },
    "detail": {
      "$ref": "#/$defs/i18n"
    },
    "when": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "window_start",
        "window_end"
      ],
      "properties": {
        "window_start": {
          "type": "string",
          "format": "date"
        },
        "window_end": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "money_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "amount_min",
        "amount_max",
        "currency",
        "basis",
        "price_source_ids",
        "sample"
      ],
      "properties": {
        "direction": {
          "enum": [
            "saves",
            "costs"
          ]
        },
        "amount_min": {
          "type": "number",
          "minimum": 0
        },
        "amount_max": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "basis": {
          "type": "string"
        },
        "price_source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "sample": {
          "type": "boolean",
          "description": "true when prices/areas are sample values (must be shown as 'sample')"
        }
      }
    },
    "do_not": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/i18n"
      }
    },
    "receipt": {
      "$ref": "receipt.schema.json"
    },
    "receipt_credential_id": {
      "type": "string",
      "pattern": "^urn:uuid:",
      "description": "id of the signed AdviceReceiptCredential (QR target)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "input_decision"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "decision",
          "traffic_light"
        ]
      }
    }
  ],
  "$defs": {
    "i18n": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "Map of BCP-47 language tag -> text, e.g. {\"bn\": \"...\", \"en\": \"...\"}"
    }
  }
}